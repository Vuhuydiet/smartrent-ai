# Environment variables
VERSION=1.0.0

# Database
MYSQL_SERVER=localhost
MYSQL_USER=smartrent
MYSQL_PASSWORD=password
MYSQL_DB=smartrent_ai
MYSQL_PORT=3306

# Environment
ENVIRONMENT=development
DEBUG=true

# LLM Provider Configuration
# Switch between providers by changing LLM_PROVIDER.
#   gemini  → Vertex AI (service account) OR Google AI Studio (API key)
#   openai  → uses OPENAI_API_KEY
#   litellm → caller passes a fully-qualified model id (e.g. "anthropic/claude-3-5-sonnet")
LLM_PROVIDER=gemini

# --- Gemini auth: pick ONE of the two paths below ---
#
# Path A: Vertex AI (service account) — production-grade
# 1. Create a Service Account in GCP Console and download the JSON key.
# 2. Base64-encode the JSON file:
#    Linux/Mac: base64 -w 0 service-account.json
#    PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# 3. Paste the base64 string below. GCP_PROJECT_ID is required.
GCP_CREDENTIALS_BASE64=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
#
# Path B: Google AI Studio (simple API key) — easier for local dev
# Leave Path A blank and set the API key below.
GEMINI_API_KEY=

# --- Other providers ---
OPENAI_API_KEY=

# Per-task model identifiers — bare model names (provider prefix is added
# automatically). Examples: "gemini-2.5-flash", "gpt-4o-mini".
LLM_CHAT_MODEL=gemini-2.5-flash
# gemini-3.1-flash-lite: cheaper than 2.5-flash and supports vision + structured
# output. If it 404s on your Vertex project/region (LLM_MODEL_NOT_FOUND), use
# gemini-2.0-flash-lite instead — long-GA, stable, cheaper still.
LLM_VISION_MODEL=gemini-3.1-flash-lite
LLM_PRICE_MODEL=gemini-2.5-flash

# SmartRent Backend Configuration
SMARTRENT_BACKEND_URL=http://localhost:8080

# Public frontend URL used to build shareable listing links
# (e.g. https://thuenhatro.net/listing-detail/{id}). Set to the deployed domain.
FRONTEND_URL=https://thuenhatro.net

# Chat Configuration
MAX_LISTINGS_RETURN=5

# Price Suggestion Configuration
# In-process TTL cache for /price-suggestion — avoids re-running the pricing
# agent (up to 12 turns) for repeat requests, e.g. the frontend wizard step
# re-mounting. No Redis needed (single uvicorn worker).
PRICE_SUGGESTION_CACHE_TTL_SECONDS=3600
PRICE_SUGGESTION_CACHE_MAXSIZE=500

# Langfuse Observability (https://cloud.langfuse.com or self-hosted)
# Leave empty to disable tracing
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# CORS — comma-separated list of allowed FE origins.
# Dev default works for Next.js (3000), Vite (5173), and Spring Boot proxy (8080).
# In production, set to your FE domain(s):
#   CORS_ALLOWED_ORIGINS=https://app.smartrent.com,https://smartrent.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

GOOGLE_MAPS_API_KEY=your-google-maps-api-key
