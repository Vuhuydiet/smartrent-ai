# Environment variables
VERSION=1.0.0

# Database
MYSQL_SERVER=localhost
MYSQL_USER=smartrent
MYSQL_PASSWORD=password
MYSQL_DB=smartrent_ai
MYSQL_PORT=3306

# Environment
ENVIRONMENT=development
DEBUG=true

# Google Cloud / Vertex AI Configuration
# 1. Create a Service Account in GCP Console and download JSON key
# 2. Base64-encode the JSON file:
#    Linux/Mac: base64 -w 0 service-account.json
#    PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# 3. Paste the base64 string below:
GCP_CREDENTIALS_BASE64=
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_PRICE_MODEL=gemini-2.0-flash-exp

# SmartRent Backend Configuration
SMARTRENT_BACKEND_URL=http://localhost:8080

# Chat Configuration
MAX_LISTINGS_RETURN=5

# Langfuse Observability (https://cloud.langfuse.com or self-hosted)
# Leave empty to disable tracing
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
